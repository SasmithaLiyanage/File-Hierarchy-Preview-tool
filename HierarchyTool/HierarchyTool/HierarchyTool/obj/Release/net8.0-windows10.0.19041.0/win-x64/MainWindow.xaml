<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HierarchyTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HierarchyTool"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Hierarchy Previewer">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid Background="#00131C">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15*" />
            <ColumnDefinition Width="10*" />
        </Grid.ColumnDefinitions>

        <!-- Left: Editor / Templates -->
        <Border Grid.Column="0" Background="#00131C">
            <Grid Padding="28,32,30,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Image Source="ms-appx:///Assets/open-folder.png" Width="48" Height="48" Stretch="Uniform" />
                    <TextBlock Text="Hierarchy Previewer" Foreground="#F4F8FC" FontSize="25" VerticalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,28,0,12">
                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock Text="> codebase" Foreground="#91A4B4" FontSize="18" />
                            <TextBlock HorizontalAlignment="Right" Foreground="#91A4B4" FontSize="13">
                                <Run Foreground="#3A73F4" Text="folder" /><Run Text=" - create a directory" />
                            </TextBlock>
                        </Grid>
                        <TextBlock x:ConnectionId='12' x:Name="DestinationTextBlock" Text="Destination: not selected" Foreground="#6D8493" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <Button x:ConnectionId='9' Content="Vite React" x:Name="ViteButton"                          Background="#102F45" Foreground="#F4F8FC" />
                        <Button x:ConnectionId='10' Content="Spring Boot" x:Name="SpringButton"                            Background="#102F45" Foreground="#F4F8FC" />
                        <Button x:ConnectionId='11' Content="Blank" x:Name="BlankButton"                           Background="#102F45" Foreground="#F4F8FC" />
                    </StackPanel>
                    <Border Grid.Row="1" BorderBrush="#17323E" BorderThickness="2" CornerRadius="16" Background="#001B26">
                        <Grid>
                            <TextBox x:ConnectionId='6' x:Name="ScriptTextBox" AcceptsReturn="True" TextWrapping="Wrap" Padding="14,12" BorderThickness="0" Background="Transparent" Foreground="#F4F8FC" PlaceholderText="folder name1 { file name2.txt }" FontFamily="Consolas" FontSize="14" IsTabStop="True" TabIndex="0"                                                                         />
                            <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,14" Orientation="Horizontal" Spacing="8">
                                <Button x:ConnectionId='7' Content="Add file" x:Name="AddFileButton"                             Background="#123146" Foreground="#91A4B4" />
                                <Button x:ConnectionId='8' Content="Add folder" x:Name="AddFolderButton"                               Background="#123146" Foreground="#91A4B4" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Right: Preview and actions -->
        <Border Grid.Column="1">
            <Grid>
                <Grid.Background>
                    <ImageBrush ImageSource="ms-appx:///Assets/righthandbackground.png" Stretch="UniformToFill" Opacity="0.8" />
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Padding="56,48,40,20" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:ConnectionId='5' x:Name="PreviewPanel" HorizontalAlignment="Left" />
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,0,42,24">
                    <Button x:ConnectionId='2' x:Name="ExportMarkdownButton"                              Background="#D8D8D8" Foreground="#222222">
                        <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE74E;" /><TextBlock Text="save" /></StackPanel>
                    </Button>
                    <Button x:ConnectionId='3' x:Name="ExportImageButton"                           Background="#D8D8D8" Foreground="#222222">
                        <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE91B;" /><TextBlock Text="Image" /></StackPanel>
                    </Button>
                    <Button x:ConnectionId='4' x:Name="GenerateFilesButton"                             Background="#D8D8D8" Foreground="#222222">
                        <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE756;" /><TextBlock Text="terminal" /></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

